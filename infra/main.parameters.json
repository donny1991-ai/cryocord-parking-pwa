{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "containerRegistryName": {
      "value": "${AZURE_CONTAINER_REGISTRY_NAME=acrcryocordparkingprod}"
    },
    "databaseUrl": {
      "value": "${DATABASE_URL}"
    },
    "databaseSsl": {
      "value": "${DATABASE_SSL=true}"
    },
    "databaseSslRejectUnauthorized": {
      "value": "${DATABASE_SSL_REJECT_UNAUTHORIZED=true}"
    },
    "databasePoolMax": {
      "value": "${DATABASE_POOL_MAX=3}"
    },
    "parkingQrKeyId": {
      "value": "${PARKING_QR_KEY_ID=prod}"
    },
    "parkingQrSigningKey": {
      "value": "${PARKING_QR_SIGNING_KEY=}"
    },
    "supabaseJwtSecret": {
      "value": "${SUPABASE_JWT_SECRET=}"
    },
    "supabaseUrl": {
      "value": "${SUPABASE_URL=}"
    },
    "supabaseServiceRoleKey": {
      "value": "${SUPABASE_SERVICE_ROLE_KEY=}"
    },
    "parkingEntrySnapshotBucket": {
      "value": "${PARKING_ENTRY_SNAPSHOT_BUCKET=parking-entry-snapshots}"
    },
    "authOtpSecret": {
      "value": "${AUTH_OTP_SECRET=}"
    },
    "publicAppUrl": {
      "value": "${NEXT_PUBLIC_APP_URL=}"
    },
    "smtpHost": {
      "value": "${SMTP_HOST=mail.cryocord.com.my}"
    },
    "smtpPort": {
      "value": "${SMTP_PORT=465}"
    },
    "smtpUser": {
      "value": "${SMTP_USER=aiprojects@cryocord.com.my}"
    },
    "smtpFrom": {
      "value": "${SMTP_FROM=}"
    },
    "smtpPass": {
      "value": "${SMTP_PASS=}"
    },
    "redisUrl": {
      "value": "${CACHE_REDIS_URL=}"
    },
    "redisKeyPrefix": {
      "value": "${CACHE_REDIS_KEY_PREFIX=cryocord-parking:}"
    },
    "smtpSecure": {
      "value": "${SMTP_SECURE=true}"
    },
    "smtpTlsRejectUnauthorized": {
      "value": "${SMTP_TLS_REJECT_UNAUTHORIZED=true}"
    },
    "smtpEhloDomain": {
      "value": "${SMTP_EHLO_DOMAIN=cryocord-parking.azurecontainerapps.io}"
    },
    "minReplicas": {
      "value": "${CONTAINER_APP_MIN_REPLICAS=1}"
    },
    "maxReplicas": {
      "value": "${CONTAINER_APP_MAX_REPLICAS=5}"
    },
    "cpuCores": {
      "value": "${CONTAINER_APP_CPU_CORES=1.0}"
    },
    "memory": {
      "value": "${CONTAINER_APP_MEMORY=2Gi}"
    },
    "httpScaleConcurrentRequests": {
      "value": "${CONTAINER_APP_HTTP_SCALE_CONCURRENT_REQUESTS=25}"
    }
  }
}
