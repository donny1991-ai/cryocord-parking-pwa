{
  "name": "cryocord-parking-pwa",
  "version": "0.1.0",
  "private": true,
  "description": "CryoCord Car Park PWA — guard entry/exit logging, QR passes, occupancy. ICS parking module.",
  "scripts": {
    "dev": "next dev --webpack",
    "dev:https": "next dev --webpack --experimental-https -H 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:integration": "NODE_ENV=test vitest run --project integration",
    "typecheck": "tsc --noEmit",
    "db:migration:run": "TS_NODE_PROJECT=tsconfig.typeorm.json typeorm-ts-node-commonjs -d src/db/data-source.ts migration:run",
    "db:migration:revert": "TS_NODE_PROJECT=tsconfig.typeorm.json typeorm-ts-node-commonjs -d src/db/data-source.ts migration:revert",
    "db:migration:show": "TS_NODE_PROJECT=tsconfig.typeorm.json typeorm-ts-node-commonjs -d src/db/data-source.ts migration:show",
    "db:migrate:fresh": "node scripts/run-ts-node.cjs src/db/migrate-fresh.ts",
    "db:migrate:fresh:seed": "node scripts/run-ts-node.cjs src/db/migrate-fresh.ts --seed",
    "db:migrate:fresh:demo": "node scripts/run-ts-node.cjs src/db/migrate-fresh.ts --seed --demo",
    "db:seed": "node scripts/run-ts-node.cjs src/db/seed.ts",
    "db:seed:demo": "node scripts/run-ts-node.cjs src/db/seed.ts --demo"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "@yudiel/react-qr-scanner": "^2.0.8",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "dotenv": "^16.6.1",
    "jose": "^5.9.6",
    "lucide-react": "^0.453.0",
    "next": "^16.2.6",
    "pg": "^8.21.0",
    "qrcode.react": "^4.1.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "recharts": "^2.13.0",
    "reflect-metadata": "^0.2.2",
    "tailwind-merge": "^2.5.4",
    "tesseract.js": "^5.1.1",
    "typeorm": "^0.3.30"
  },
  "devDependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@faker-js/faker": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.16.11",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.8",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "jsdom": "^26.1.0",
    "postcss": "8.5.10",
    "tailwindcss": "^3.4.13",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "postcss": "8.5.10",
    "workbox-build": "7.4.1",
    "workbox-webpack-plugin": "7.4.1"
  }
}
