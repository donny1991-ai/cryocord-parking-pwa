# Dedicated isolated test database only.
# Local test database: supabase_db_cryocord-hr-test
# Connects to the default Supabase `postgres` database; test tables live in the `parking` schema.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
TEST_DATABASE_SSL=false
# Required when using a remote Supabase test project URL that does not contain
# "test" in the hostname/database name.
CONFIRM_TEST_DATABASE_IS_ISOLATED=false

# Supabase Auth test token verification. Keep this aligned with the isolated
# test Supabase project if tests use real Supabase-issued access tokens.
TEST_SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

PARKING_QR_KEY_ID=test
PARKING_QR_SIGNING_KEY=test-only-signing-key-replace-for-shared-test-env
