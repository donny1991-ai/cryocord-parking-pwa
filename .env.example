# CryoCord Parking PWA — environment
# Secrets are provisioned via Azure Key Vault in real environments; this file
# documents the shape only. Never commit a filled .env.

# Self-hosted Supabase (Azure Malaysia West) — operational store for the
# `parking` schema. Managed Supabase, if any, is auth-ONLY (no visitor PII).
NEXT_PUBLIC_SUPABASE_URL=https://supabase.parking.internal.cryocord.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# QR pass signing — HS256, rotated quarterly, key id enables rotation.
# Token payload is an OPAQUE visit_id reference only (no plate/PII). See lib/qr.ts.
PARKING_QR_SIGNING_KEY=
PARKING_QR_KEY_ID=2026Q2

# Azure Blob (MY West) — entry photos / plate snapshots.
AZURE_BLOB_ACCOUNT=
AZURE_BLOB_CONTAINER=parking-entry-photos

# ICS audit mirror endpoint (HMAC). Transport for the async mirror worker —
# NOT the source of truth. Local audit row is written same-transaction first.
ICS_AUDIT_MIRROR_URL=
ICS_AUDIT_HMAC_SECRET=

# Overstay threshold (hours) before a visit is flagged for a push alert.
NEXT_PUBLIC_OVERSTAY_HOURS=4
