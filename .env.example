# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase/Postgres
# Local app/dev database: supabase_db_Cryocord-Policy-Hub-and-HR
# Connects to the default Supabase `postgres` database; app tables live in the `parking` schema.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_SSL=false
# Use this only when running the app itself inside Docker Compose. From inside
# the app container, 127.0.0.1 is the app container, so host.docker.internal is required.
DOCKER_DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:54322/postgres
# SUPABASE_DB_URL can be used instead of DATABASE_URL if your infra names it that way.

# QR signing
# Production value should come from Azure Key Vault / Container App secrets.
PARKING_QR_KEY_ID=local
PARKING_QR_SIGNING_KEY=replace-with-a-long-random-secret-at-least-32-bytes

# Optional TypeORM logging for local debugging.
TYPEORM_LOGGING=false
